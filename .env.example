# Environment Variables Template
# Copy this to `.env` (local) or `.env.docker` (Docker) and fill in your values.
#
# This repo’s `apps/fullstack` is based on the Placemark fullstack app, which requires
# several server + client env vars at startup.

# Server-side Placemark config (required)
DOMAIN=localhost
BLOG_RSS_URL=https://blog.placemark.io/rss.xml
WFC_QUOTA=10
WFC_QUOTA_ENTERPRISE=100
TEAM_EMAIL=example@example.com
GITHUB_CLIENT_ID=example
GITHUB_CLIENT_SECRET=example

# Database URL - for local development (localhost)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/urban_planner

# Client-side Placemark config (required)
NEXT_PUBLIC_FILE_LIMIT_MB=10
NEXT_PUBLIC_FILE_WARN_MB=5

# Mapbox Token (get from https://account.mapbox.com/)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# Environment
NODE_ENV=development
